# PostgreSQL (используются сервисом postgres и backend)
POSTGRES_USER=quest
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=quest_fitness

# Prisma / Nest (backend) — пароль должен совпадать с POSTGRES_PASSWORD
DATABASE_URL=postgresql://quest:replace-me@postgres:5432/quest_fitness?schema=public

# Сессии и зал (backend)
SESSION_SECRET=replace-me-min-32-chars-session-secret
GYM_TIMEZONE=Europe/Moscow

# Seed администратора — задайте сильные значения локально в .env (не коммитьте .env)
SEED_ADMIN_LOGIN=
SEED_ADMIN_PASSWORD=

# Опционально
NODE_ENV=production
# local → cookie без Secure (браузер на http://localhost); staging/prod → Secure
APP_ENV=local
