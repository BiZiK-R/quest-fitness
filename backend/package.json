{
  "name": "@quest-fitness/backend",
  "private": true,
  "version": "0.1.0",
  "description": "Quest Fitness API — Nest BFF",
  "scripts": {
    "build": "nest build",
    "prebuild": "npm run openapi:export",
    "openapi:export": "tsx src/scripts/export-openapi.ts",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "vitest run",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "postinstall": "prisma generate && node scripts/patch-nest-interfaces.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@nestjs/swagger": {
      "@nestjs/common": "12.1.1",
      "@nestjs/core": "12.1.1"
    }
  },
  "dependencies": {
    "@nestjs/common": "12.1.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/platform-express": "12.1.1",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.41.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.2",
    "@nestjs/testing": "12.1.1",
    "@swc/core": "1.15.18",
    "@types/argon2": "0.14.1",
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/supertest": "6.0.3",
    "prisma": "7.10.0",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "unplugin-swc": "1.5.7",
    "vitest": "3.2.7",
    "yaml": "^2.8.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
