generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TRAINER
  CLIENT
}

model User {
  id            String         @id @default(cuid())
  login         String         @unique
  phoneE164     String?        @unique @map("phone_e164")
  passwordHash  String         @map("password_hash")
  role          UserRole
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  authSessions       AuthSession[]
  clientProfile      ClientProfile?
  invitesIssued      Invite[]
  clientLocksHeld    ClientLock[]
  workoutsCreated    Workout[]
  sessionsAuthored   Session[]      @relation("SessionAuthor")

  @@map("users")
}

model ClientProfile {
  id            String       @id @default(cuid())
  displayName   String       @map("display_name")
  userId        String?      @unique @map("user_id")
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  deactivatedAt DateTime?    @map("deactivated_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  invites       Invite[]
  clientLock    ClientLock?
  macroProgress ClientMacroProgress?
  workouts      Workout[]
  sessions      Session[]

  @@map("client_profiles")
}

model ClientLock {
  clientId          String        @id @map("client_id")
  client            ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  holderTrainerId   String        @map("holder_trainer_id")
  holderTrainer     User          @relation(fields: [holderTrainerId], references: [id], onDelete: Restrict)
  lastActivityAt    DateTime      @map("last_activity_at")
  activeSessionId   String?       @map("active_session_id")
  createdAt         DateTime      @default(now()) @map("created_at")

  @@map("client_locks")
}

model Invite {
  id              String        @id @default(cuid())
  clientProfileId String        @map("client_profile_id")
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  issuedByUserId  String        @map("issued_by_user_id")
  issuedByUser    User          @relation(fields: [issuedByUserId], references: [id], onDelete: Restrict)
  tokenHash       String        @unique @map("token_hash")
  expiresAt       DateTime      @map("expires_at")
  consumedAt      DateTime?     @map("consumed_at")
  revokedAt       DateTime?     @map("revoked_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([clientProfileId])
  @@map("invites")
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfToken String   @map("csrf_token")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("auth_sessions")
}

enum ExerciseMuscleRole {
  PRIMARY
  SECONDARY
}

model MuscleGroup {
  id        String           @id @default(cuid())
  name      String           @unique
  sortOrder Int?             @map("sort_order")
  createdAt DateTime         @default(now()) @map("created_at")
  exerciseMuscles ExerciseMuscle[]

  @@map("muscle_groups")
}

model Exercise {
  id         String           @id @default(cuid())
  name       String
  archivedAt DateTime?        @map("archived_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  muscles           ExerciseMuscle[]
  templateExercises TemplateExercise[]
  sessionExercises  SessionExercise[]

  @@map("exercises")
}

model WorkoutTemplate {
  id              String             @id @default(cuid())
  name            String
  type            String
  description     String?
  durationMinutes Int?               @map("duration_minutes")
  microcycleWeeks Int?               @map("microcycle_weeks")
  version         Int                @default(1)
  archivedAt      DateTime?          @map("archived_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  exercises       TemplateExercise[]
  macrocycleStages MacrocycleStage[]
  workouts         Workout[]

  @@map("workout_templates")
}

model Macrocycle {
  id              String                @id @default(cuid())
  name            String
  periodicityNote String?               @map("periodicity_note")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  stages          MacrocycleStage[]
  clientProgress  ClientMacroProgress[]

  @@map("macrocycles")
}

model MacrocycleStage {
  id           String                @id @default(cuid())
  macrocycleId String                @map("macrocycle_id")
  macrocycle   Macrocycle            @relation(fields: [macrocycleId], references: [id], onDelete: Cascade)
  templateId   String                @map("template_id")
  template     WorkoutTemplate       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  sortOrder    Int                   @map("sort_order")
  progressAtStage ClientMacroProgress[] @relation("MacroProgressCurrentStage")
  sourceWorkouts  Workout[]

  @@unique([macrocycleId, sortOrder])
  @@map("macrocycle_stages")
}

enum WorkoutStatus {
  pending
  attended
  skipped
  cancelled
}

model Workout {
  id              String         @id @default(cuid())
  clientProfileId String         @map("client_profile_id")
  clientProfile   ClientProfile  @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime       @map("scheduled_at")
  status          WorkoutStatus  @default(pending)
  templateId      String?        @map("template_id")
  template        WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sourceStageId   String?        @map("source_stage_id")
  sourceStage     MacrocycleStage? @relation(fields: [sourceStageId], references: [id], onDelete: SetNull)
  createdByUserId String         @map("created_by_user_id")
  createdByUser   User           @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  session         Session?

  @@index([clientProfileId, scheduledAt])
  @@map("workouts")
}

enum SessionStatus {
  active
  completed
  abandoned
}

model Session {
  id                     String            @id @default(cuid())
  workoutId              String            @unique @map("workout_id")
  workout                Workout           @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  clientProfileId        String            @map("client_profile_id")
  clientProfile          ClientProfile     @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  authorTrainerId        String            @map("author_trainer_id")
  authorTrainer          User              @relation("SessionAuthor", fields: [authorTrainerId], references: [id], onDelete: Restrict)
  status                 SessionStatus     @default(active)
  startedAt              DateTime          @map("started_at")
  completedAt            DateTime?         @map("completed_at")
  abandonedAt            DateTime?         @map("abandoned_at")
  plannedDurationMinutes Int?              @map("planned_duration_minutes")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  exercises              SessionExercise[]
  sets                   Set[]

  @@index([clientProfileId])
  @@map("sessions")
}

model SessionExercise {
  id              String   @id @default(cuid())
  sessionId       String   @map("session_id")
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId      String   @map("exercise_id")
  exercise        Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sortOrder       Int      @map("sort_order")
  plannedSets     Int?     @map("planned_sets")
  plannedReps     Int?     @map("planned_reps")
  plannedWeightKg Decimal? @map("planned_weight_kg") @db.Decimal(10, 2)
  nameSnapshot    String   @map("name_snapshot")
  notes           String?
  sets            Set[]

  @@unique([sessionId, sortOrder])
  @@map("session_exercises")
}

model Set {
  id                  String          @id
  sessionId           String          @map("session_id")
  session             Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionExerciseId   String          @map("session_exercise_id")
  sessionExercise     SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
  sequenceIndex       Int             @map("sequence_index")
  weightKg            Decimal?        @map("weight_kg") @db.Decimal(10, 2)
  reps                Int?
  rpe                 Decimal?        @db.Decimal(3, 1)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  @@index([sessionId, sequenceIndex])
  @@map("sets")
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  idempotencyKey String   @map("idempotency_key")
  scope          String
  actorUserId    String   @map("actor_user_id")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([scope, idempotencyKey])
  @@index([createdAt])
  @@map("idempotency_records")
}

model ClientMacroProgress {
  id              String           @id @default(cuid())
  clientProfileId String           @unique @map("client_profile_id")
  clientProfile   ClientProfile    @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  macrocycleId    String           @map("macrocycle_id")
  macrocycle      Macrocycle       @relation(fields: [macrocycleId], references: [id], onDelete: Cascade)
  currentStageId  String?          @map("current_stage_id")
  currentStage    MacrocycleStage? @relation("MacroProgressCurrentStage", fields: [currentStageId], references: [id], onDelete: SetNull)

  @@map("client_macro_progress")
}

model TemplateExercise {
  id              String          @id @default(cuid())
  templateId      String          @map("template_id")
  template        WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exerciseId      String          @map("exercise_id")
  exercise        Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sortOrder       Int             @map("sort_order")
  plannedSets     Int?            @map("planned_sets")
  plannedReps     Int?            @map("planned_reps")
  plannedWeightKg Decimal?        @map("planned_weight_kg") @db.Decimal(10, 2)
  notes           String?

  @@unique([templateId, sortOrder])
  @@map("template_exercises")
}

model ExerciseMuscle {
  exerciseId    String             @map("exercise_id")
  exercise      Exercise           @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroupId String             @map("muscle_group_id")
  muscleGroup   MuscleGroup        @relation(fields: [muscleGroupId], references: [id], onDelete: Restrict)
  role          ExerciseMuscleRole

  @@id([exerciseId, muscleGroupId])
  @@map("exercise_muscles")
}
