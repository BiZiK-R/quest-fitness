generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TRAINER
  CLIENT
}

model User {
  id            String         @id @default(cuid())
  login         String         @unique
  phoneE164     String?        @unique @map("phone_e164")
  passwordHash  String         @map("password_hash")
  role          UserRole
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  authSessions       AuthSession[]
  clientProfile      ClientProfile?
  invitesIssued      Invite[]
  clientLocksHeld    ClientLock[]

  @@map("users")
}

model ClientProfile {
  id            String       @id @default(cuid())
  displayName   String       @map("display_name")
  userId        String?      @unique @map("user_id")
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  deactivatedAt DateTime?    @map("deactivated_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  invites       Invite[]
  clientLock    ClientLock?

  @@map("client_profiles")
}

model ClientLock {
  clientId          String        @id @map("client_id")
  client            ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  holderTrainerId   String        @map("holder_trainer_id")
  holderTrainer     User          @relation(fields: [holderTrainerId], references: [id], onDelete: Restrict)
  lastActivityAt    DateTime      @map("last_activity_at")
  activeSessionId   String?       @map("active_session_id")
  createdAt         DateTime      @default(now()) @map("created_at")

  @@map("client_locks")
}

model Invite {
  id              String        @id @default(cuid())
  clientProfileId String        @map("client_profile_id")
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  issuedByUserId  String        @map("issued_by_user_id")
  issuedByUser    User          @relation(fields: [issuedByUserId], references: [id], onDelete: Restrict)
  tokenHash       String        @unique @map("token_hash")
  expiresAt       DateTime      @map("expires_at")
  consumedAt      DateTime?     @map("consumed_at")
  revokedAt       DateTime?     @map("revoked_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([clientProfileId])
  @@map("invites")
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfToken String   @map("csrf_token")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("auth_sessions")
}

enum ExerciseMuscleRole {
  PRIMARY
  SECONDARY
}

model MuscleGroup {
  id        String           @id @default(cuid())
  name      String           @unique
  sortOrder Int?             @map("sort_order")
  createdAt DateTime         @default(now()) @map("created_at")
  exerciseMuscles ExerciseMuscle[]

  @@map("muscle_groups")
}

model Exercise {
  id         String           @id @default(cuid())
  name       String
  archivedAt DateTime?        @map("archived_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  muscles    ExerciseMuscle[]

  @@map("exercises")
}

model ExerciseMuscle {
  exerciseId    String             @map("exercise_id")
  exercise      Exercise           @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroupId String             @map("muscle_group_id")
  muscleGroup   MuscleGroup        @relation(fields: [muscleGroupId], references: [id], onDelete: Restrict)
  role          ExerciseMuscleRole

  @@id([exerciseId, muscleGroupId])
  @@map("exercise_muscles")
}
